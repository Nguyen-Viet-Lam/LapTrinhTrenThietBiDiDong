rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // Blocked Users Subcollection
      match /blockedUsers/{blockedUid} {
        allow read, write: if isOwner(userId);
      }
    }

    // Quests Collection
    match /quests/{questId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.groupId != null ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.groupId != null) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );

      // Quest Steps Subcollection
      match /steps/{stepId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Groups Collection
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );

      // Group Members Subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (request.auth.uid == memberId || resource.data.ownerId == request.auth.uid);
        allow update, delete: if isAuthenticated() && (
          request.auth.uid == memberId ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }

      // Group Messages (Chat) Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Safety Reports Collection
    match /safetyReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // AI Plans Collection
    match /aiPlans/{planId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.ownerId == request.auth.uid
      );
    }
  }
}

